{
  "name": "codebase-graph-mcp",
  "displayName": "Codebase Graph",
  "version": "0.4.2",
  "description": "Dependency graph of your codebase for safer changes: what a file imports, what depends on it, what a change would break, circular imports, git churn and co-change, and interactive graph pages. TypeScript/JavaScript, Python and Rust.",
  "author": { "name": "0xbyt4", "url": "https://github.com/0xbyt4" },
  "homepage": "https://github.com/0xbyt4/codebase-graph-mcp#readme",
  "repository": "https://github.com/0xbyt4/codebase-graph-mcp",
  "documentationUrl": "https://github.com/0xbyt4/codebase-graph-mcp#readme",
  "supportUrl": "https://github.com/0xbyt4/codebase-graph-mcp/issues",
  "privacyPolicyUrl": "https://github.com/0xbyt4/codebase-graph-mcp#what-the-server-runs-and-sends",
  "termsOfServiceUrl": "https://github.com/0xbyt4/codebase-graph-mcp/blob/main/LICENSE",
  "license": "MIT",
  "keywords": ["mcp", "codebase", "dependency-graph", "impact-analysis", "refactoring", "architecture"],
  "mcpServers": {
    "codebase-graph": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/build/index.js"]
    }
  }
}
